{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "wc",
  "version": "0.1.0",
  "identifier": "wc.dyblog.online",
  "build": {
    "beforeDevCommand": "node scripts/dev-server.mjs",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WindowsCleaner",
        "width": 320,
        "height": 400,
        "resizable": false,
        "minWidth": 320,
        "minHeight": 360,
        "decorations": false,
        "transparent": false,
        "center": true
      },
      {
        "label": "custom-clean",
        "title": "自定义清理",
        "url": "index.html#/custom-clean",
        "width": 760,
        "height": 520,
        "resizable": false,
        "minWidth": 680,
        "minHeight": 460,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false
      },
      {
        "label": "settings",
        "title": "设置",
        "url": "index.html#/settings",
        "width": 560,
        "height": 520,
        "resizable": false,
        "minWidth": 520,
        "minHeight": 500,
        "decorations": false,
        "transparent": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
